{
  "info": {
    "name": "GymFit – API app clientes",
    "description": "Endpoints de la app móvil de clientes (NUUCLEO). Corre Auth → Login primero: el token se guarda solo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Fecha de hoy en la zona del negocio (AAAA-MM-DD)",
          "pm.variables.set('hoy', new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Mazatlan' }).format(new Date()));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3005/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "idHorario",
      "value": ""
    },
    {
      "key": "idHorarioNuevo",
      "value": ""
    },
    {
      "key": "idReservacion",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Registro",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "registro"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Mariana\",\n  \"apellidos\": \"Ríos\",\n  \"fechaNacimiento\": \"1995-04-12\",\n  \"correo\": \"mariana@correo.com\",\n  \"telefono\": \"6681234567\",\n  \"password\": \"Clave1234\",\n  \"confirmarPassword\": \"Clave1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Crea la cuenta y guarda el token. Respuestas: 201 { token, cliente }; 409 si el correo ya existe."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.token) { pm.collectionVariables.set('token', j.token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"mariana@correo.com\",\n  \"password\": \"Clave1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.token) { pm.collectionVariables.set('token', j.token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Activar cuenta (alta en recepción)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/activar-cuenta",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "activar-cuenta"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"cliente@correo.com\",\n  \"codigoAcceso\": \"CL-XXXXXXXX\",\n  \"password\": \"Clave1234\",\n  \"confirmarPassword\": \"Clave1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.token) { pm.collectionVariables.set('token', j.token); }"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Perfil",
      "item": [
        {
          "name": "Mi perfil y membresía",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me"
              ]
            }
          }
        },
        {
          "name": "Editar perfil",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"telefono\": \"6689876543\",\n  \"direccion\": \"Av. Reforma 123, Los Mochis\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Cambiar contraseña",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/me/password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me",
                "password"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"passwordActual\": \"Clave1234\",\n  \"password\": \"NuevaClave1234\",\n  \"confirmarPassword\": \"NuevaClave1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Clases",
      "item": [
        {
          "name": "Tipos de clase (filtros)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/clases",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "clases"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Horarios",
      "item": [
        {
          "name": "Tira de días",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/horarios/dias?cantidad=14",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "horarios",
                "dias"
              ],
              "query": [
                {
                  "key": "cantidad",
                  "value": "14"
                }
              ]
            }
          }
        },
        {
          "name": "Clases del día",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/horarios?fecha={{hoy}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "horarios"
              ],
              "query": [
                {
                  "key": "fecha",
                  "value": "{{hoy}}"
                }
              ]
            },
            "description": "Agrega &clase=Pilates para filtrar. Guarda el primer horario reservable en {{idHorario}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "const libre = (j.horarios || []).find(h => h.reservable);",
                  "if (libre) { pm.collectionVariables.set('idHorario', libre.idHorario); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Hoja de confirmación",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/horarios/{{idHorario}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "horarios",
                "{{idHorario}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Reservaciones",
      "item": [
        {
          "name": "Reservar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reservaciones",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reservaciones"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idHorario\": \"{{idHorario}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) { pm.collectionVariables.set('idReservacion', pm.response.json().idReservacion); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Mis reservas (próximas e historial)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reservaciones",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reservaciones"
              ]
            },
            "description": "Agrega ?tipo=proximas o ?tipo=historial para traer solo una pestaña (el conteo siempre viene completo)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (!pm.collectionVariables.get('idReservacion') && j.proximas && j.proximas[0]) {",
                  "  pm.collectionVariables.set('idReservacion', j.proximas[0].idReservacion);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Ver QR (detalle)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reservaciones/{{idReservacion}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reservaciones",
                "{{idReservacion}}"
              ]
            }
          }
        },
        {
          "name": "Opciones para reagendar",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reservaciones/{{idReservacion}}/opciones-reagendar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reservaciones",
                "{{idReservacion}}",
                "opciones-reagendar"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.opciones && j.opciones[0]) { pm.collectionVariables.set('idHorarioNuevo', j.opciones[0].idHorario); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Reagendar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reservaciones/{{idReservacion}}/reagendar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reservaciones",
                "{{idReservacion}}",
                "reagendar"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idHorario\": \"{{idHorarioNuevo}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Cancelar",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reservaciones/{{idReservacion}}/cancelar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reservaciones",
                "{{idReservacion}}",
                "cancelar"
              ]
            }
          }
        }
      ]
    }
  ]
}