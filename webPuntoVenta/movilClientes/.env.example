# Backend de la app móvil de clientes: backendMovil/ (puerto 3005).
# Su configuración va en backendMovil/.env (ver backendMovil/.env.example).
# Esta carpeta ya no es "solo cliente": el backend móvil comparte la base de datos
# (webadministrativa_clientes, _reservaciones, _clases, _horarios) con la web administrativa.
API_MOVIL_URL=http://localhost:3005
API_ADMINISTRATIVA_URL=http://localhost:3001
