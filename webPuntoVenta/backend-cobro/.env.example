# Copiar este archivo a .env antes de levantar el backend.

# Puerto fijo asignado a webCobro dentro del repositorio del equipo.
PORT=3002

# PostgreSQL - BASE DE DATOS COMPARTIDA
# (se levanta con el docker-compose del repositorio del equipo)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=sistema_reservacion_clases
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# El esquema webcobro, sus tablas y los datos de ejemplo se crean con:
#   npm run db:setup

# Impresión térmica opcional. No cambia el resultado del cobro.
TICKET_IMPRESION_HABILITADA=false
PRINTER_IP=
PRINTER_PORT=9100
PRINTER_TIMEOUT_MS=2000

# Activar SOLO después de aplicar db/asistencia-turnos.sql y configurar turnos.
# Sin activar, el checador conserva el funcionamiento previo y el esquema previo.
ASISTENCIA_TURNOS_HABILITADOS=false
# La generación de incidencias escribe datos cada minuto; autorización aparte.
ASISTENCIA_FALTAS_AUTOMATICAS=false