# Copiar este archivo a .env antes de levantar el backend.

# Puerto fijo asignado a webAdministrativa dentro del repositorio del equipo.
PORT=3001

# CORS: origen autorizado para consumir esta API desde un navegador.
CORS_ORIGIN=http://localhost:8443

# MongoDB - BASE DE DATOS COMPARTIDA
MONGO_URI=mongodb://127.0.0.1:27017/sistema_reservacion_clases
MONGO_DB_NAME=sistema_reservacion_clases
# Convencion: cada app prefija sus colecciones, ej: webadministrativa_usuarios

# JWT
JWT_SECRET=cambia_esta_clave_en_produccion
JWT_EXPIRES_IN=1d

# PostgreSQL - BASE DE DATOS COMPARTIDA
# Todavia no lo usa el codigo; queda listo para cuando se migren datos.
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=sistema_reservacion_clases
PG_USER=postgres
PG_PASSWORD=postgres