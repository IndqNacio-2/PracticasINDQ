# Copiar este archivo a backend/.env.example cuando crees el backend
PORT=3004

# PostgreSQL - BASE DE DATOS COMPARTIDA
PG_HOST=postgres
PG_PORT=5432
PG_DB=sistema_reservacion_clases
PG_USER=postgres
PG_PASSWORD=postgres
# Convencion: cada app usa su propio schema en Postgres, ej: webasistencia

# MongoDB - BASE DE DATOS COMPARTIDA
MONGO_URI=mongodb://mongo:27017/sistema_reservacion_clases
MONGO_DB_NAME=sistema_reservacion_clases
# Convencion: cada app prefija sus colecciones, ej: webasistencia_usuarios

# JWT
JWT_SECRET=cambia_esta_clave_en_produccion
JWT_EXPIRES_IN=1d

# CORS: restringir en produccion a los origenes que realmente consumen esta API
CORS_ORIGIN=*
