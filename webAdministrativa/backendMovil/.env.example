# Puerto de esta API (webadministrativa usa 3001; 3002-3004 son webCobro, webPuntoVenta y webAsistencia)
PORT=3005

# Misma base de Mongo que usa la web administrativa (dentro de Docker el host es "mongo")
MONGO_URI=mongodb://mongo:27017/sistema_reservacion_clases

# IMPORTANTE: usa un secreto DISTINTO al JWT_SECRET de la web administrativa.
# Así un token de cliente nunca sirve en la API del personal.
CLIENTES_JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=30d

# Zona horaria del negocio (para "hoy", clases pasadas y la regla de 24 h)
APP_TZ=America/Mazatlan

# Precio de una clase que no está en el paquete del cliente (si la clase no tiene precio propio)
PRECIO_CLASE_SUELTA=180

# Orígenes permitidos (la app móvil no necesita CORS; esto es para pruebas desde navegador)
CORS_ORIGIN=*
